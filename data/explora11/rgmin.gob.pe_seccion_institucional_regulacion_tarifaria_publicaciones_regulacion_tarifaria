function urlItem(index, total)
{
	var href = window.location.href;
	var itemHref = href.split('/');
	var cantidadHref = itemHref.length - 1;
	var limite = cantidadHref - total + index;
	var url="";
	for(var i=0; i<=limite; i++)
	{
		url += itemHref[i] + "/";
	}
	return url;        		
} 	 		
